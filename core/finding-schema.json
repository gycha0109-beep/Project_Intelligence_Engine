{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/finding.schema.json",
  "type": "object",
  "required": [
    "id", "title", "category", "severity", "confidence", "status",
    "scope", "evidence", "impact", "recommended_action", "verification"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "title": {"type": "string", "minLength": 3},
    "category": {"type": "string", "minLength": 3},
    "severity": {"enum": ["P0", "P1", "P2", "P3", "INFO"]},
    "confidence": {"enum": ["HYPOTHESIS", "SUPPORTED", "CONFIRMED", "RESOLVED", "REJECTED"]},
    "status": {"enum": ["OPEN", "ACCEPTED", "FIXED", "CLOSED", "REJECTED"]},
    "scope": {
      "type": "object",
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "type", "summary"],
        "properties": {
          "level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
          "type": {"enum": ["opinion", "code", "config", "documentation", "path", "test", "runtime", "database", "log", "artifact"]},
          "location": {"type": "string"},
          "command": {"type": "string"},
          "result": {"type": "string"},
          "summary": {"type": "string", "minLength": 3}
        },
        "additionalProperties": true
      }
    },
    "reproduction": {
      "type": ["object", "null"],
      "properties": {
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "observed": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      },
      "required": ["steps", "observed", "expected"],
      "additionalProperties": true
    },
    "impact": {"type": "string", "minLength": 3},
    "recommended_action": {"type": "string", "minLength": 3},
    "verification": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptance": {
      "type": "object",
      "required": ["reason", "owner", "review_by"],
      "properties": {
        "reason": {"type": "string", "minLength": 3},
        "owner": {"type": "string", "minLength": 1},
        "review_by": {"type": "string", "format": "date"}
      },
      "additionalProperties": true
    },
    "source_pack": {"type": "string"},
    "check_id": {"type": "string"}
  },
  "additionalProperties": true
}
