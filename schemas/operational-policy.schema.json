{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/operational-policy.schema.json",
  "title": "PIE Operational Review Loop v1 Operational Policy Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "project_id",
    "policy_authority",
    "operational_classes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "PIE_OPERATIONAL_POLICY_V1"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_authority": {"const": "PR_BASE_REVISION"},
    "operational_classes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9._:-]+$"},
      "additionalProperties": {"$ref": "#/$defs/operationalClass"}
    }
  },
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "readinessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "min_ledger_runs",
        "min_ledger_decisions",
        "min_defects",
        "min_closed_defects",
        "min_reground_observations",
        "min_reground_coverage",
        "min_reground_precision",
        "min_reground_recall",
        "max_reground_false_positive_rate",
        "require_active_policy",
        "require_pass_evaluation",
        "require_holdout",
        "require_repeatability",
        "require_zero_protected_negative_regressions"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "min_ledger_runs": {"type": "integer", "minimum": 1},
        "min_ledger_decisions": {"type": "integer", "minimum": 1},
        "min_defects": {"type": "integer", "minimum": 1},
        "min_closed_defects": {"type": "integer", "minimum": 0},
        "min_reground_observations": {"type": "integer", "minimum": 1},
        "min_reground_coverage": {"$ref": "#/$defs/probability"},
        "min_reground_precision": {"$ref": "#/$defs/probability"},
        "min_reground_recall": {"$ref": "#/$defs/probability"},
        "max_reground_false_positive_rate": {"$ref": "#/$defs/probability"},
        "require_active_policy": {"const": true},
        "require_pass_evaluation": {"const": true},
        "require_holdout": {"const": true},
        "require_repeatability": {"const": true},
        "require_zero_protected_negative_regressions": {"const": true}
      }
    },
    "operationalClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "trust_task_class",
        "required_scenarios",
        "required_evidence",
        "readiness_policy"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "trust_task_class": {
          "enum": [
            "generated_artifact",
            "formatting",
            "documentation",
            "routine_code",
            "dependency_change",
            "authentication",
            "authorization",
            "database_migration",
            "deployment",
            "security",
            "policy",
            "verifier"
          ]
        },
        "required_scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "readiness_policy": {"$ref": "#/$defs/readinessPolicy"}
      }
    }
  }
}
