{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/trust-comparison-registry.schema.json",
  "title": "PIE Trust Comparison Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "project_id",
    "created_at",
    "assessments",
    "events",
    "comparisons",
    "metrics",
    "registry_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"type": "string", "pattern": "^trust-comparison-[0-9a-f]{32}$"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assessment"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    },
    "comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"}
    },
    "metrics": {"type": "object"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id", "task_id", "source_revision", "trust_report_id",
        "trust_report_sha256", "predicted_risk_band", "readiness_status",
        "triggered_hard_gates", "captured_at", "assessment_sha256"
      ],
      "properties": {
        "assessment_id": {"type": "string", "pattern": "^assessment-[0-9a-f]{32}$"},
        "task_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "trust_report_id": {"type": "string", "minLength": 1},
        "trust_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "predicted_risk_band": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
        "readiness_status": {"enum": ["NOT_READY", "READY_FOR_HUMAN_COMPARISON"]},
        "triggered_hard_gates": {"type": "array", "items": {"type": "string"}},
        "captured_at": {"type": "string", "format": "date-time"},
        "assessment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "event_id", "event_type", "assessment_id", "occurred_at",
        "actor", "payload", "previous_event_sha256", "event_sha256"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{32}$"},
        "event_type": {"enum": ["HUMAN_DECISION", "OUTCOME"]},
        "assessment_id": {"type": "string", "pattern": "^assessment-[0-9a-f]{32}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "payload": {"type": "object"},
        "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id", "predicted_risk_band", "predicted_safe_candidate",
        "latest_decision_event_id", "review_level", "human_decision",
        "confirmed_risk_band", "latest_outcome_event_id", "outcome_verdict",
        "provisional_status", "confirmed_status"
      ],
      "properties": {
        "assessment_id": {"type": "string"},
        "predicted_risk_band": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
        "predicted_safe_candidate": {"type": "boolean"},
        "latest_decision_event_id": {"type": ["string", "null"]},
        "review_level": {"type": ["string", "null"]},
        "human_decision": {"type": ["string", "null"]},
        "confirmed_risk_band": {"type": ["string", "null"]},
        "latest_outcome_event_id": {"type": ["string", "null"]},
        "outcome_verdict": {"type": ["string", "null"]},
        "provisional_status": {"type": "string"},
        "confirmed_status": {"type": "string"}
      }
    }
  }
}
