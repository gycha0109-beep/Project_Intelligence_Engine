{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/trust-request.schema.json",
  "title": "PIE Trust Readiness Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source_revision",
    "task_class",
    "changed_files",
    "required_scenarios",
    "completed_scenarios",
    "repository_match",
    "head_match",
    "rollback_evidence",
    "replay_evidence",
    "readiness_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task_class": {
      "enum": [
        "generated_artifact",
        "formatting",
        "documentation",
        "routine_code",
        "dependency_change",
        "authentication",
        "authorization",
        "database_migration",
        "deployment",
        "security",
        "policy",
        "verifier"
      ]
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "required_scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "completed_scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "repository_match": {
      "type": "boolean"
    },
    "head_match": {
      "type": "boolean"
    },
    "rollback_evidence": {
      "type": "boolean"
    },
    "replay_evidence": {
      "type": "boolean"
    },
    "readiness_policy": {
      "$ref": "#/$defs/readinessPolicy"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "readinessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "min_ledger_runs",
        "min_ledger_decisions",
        "min_defects",
        "min_closed_defects",
        "min_reground_observations",
        "min_reground_coverage",
        "min_reground_precision",
        "min_reground_recall",
        "max_reground_false_positive_rate",
        "require_active_policy",
        "require_pass_evaluation",
        "require_holdout",
        "require_repeatability",
        "require_zero_protected_negative_regressions"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/id"
        },
        "policy_version": {
          "$ref": "#/$defs/id"
        },
        "min_ledger_runs": {
          "type": "integer",
          "minimum": 1
        },
        "min_ledger_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "min_defects": {
          "type": "integer",
          "minimum": 0
        },
        "min_closed_defects": {
          "type": "integer",
          "minimum": 0
        },
        "min_reground_observations": {
          "type": "integer",
          "minimum": 1
        },
        "min_reground_coverage": {
          "$ref": "#/$defs/unitInterval"
        },
        "min_reground_precision": {
          "$ref": "#/$defs/unitInterval"
        },
        "min_reground_recall": {
          "$ref": "#/$defs/unitInterval"
        },
        "max_reground_false_positive_rate": {
          "$ref": "#/$defs/unitInterval"
        },
        "require_active_policy": {
          "const": true
        },
        "require_pass_evaluation": {
          "const": true
        },
        "require_holdout": {
          "const": true
        },
        "require_repeatability": {
          "const": true
        },
        "require_zero_protected_negative_regressions": {
          "const": true
        }
      }
    }
  }
}
