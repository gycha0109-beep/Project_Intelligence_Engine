{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/prospective-automation-run-v1.schema.json",
  "title": "PIE Prospective PR Automation Run V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "execution_id",
    "repository",
    "pull_request",
    "source_revision",
    "pie_revision",
    "status",
    "auto_capture",
    "auto_analysis",
    "auto_trust_assessment",
    "auto_packet_prepare",
    "human_review_recorded",
    "outcome_recorded",
    "automation_authorized",
    "pilot_authorized",
    "deterministic_replay_bound",
    "deterministic_result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "PIE_PR_PROSPECTIVE_RUN_V1"},
    "execution_id": {"type": "string", "pattern": "^pie-pr-auto-[0-9a-f]{32}$"},
    "repository": {"type": "string", "minLength": 3},
    "pull_request": {"type": "integer", "minimum": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pie_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["WAITING_FOR_TRUST_INPUT", "READY_FOR_HUMAN_REVIEW"]},
    "candidate_id": {"type": ["string", "null"]},
    "assessment_id": {"type": ["string", "null"]},
    "packet_id": {"type": ["string", "null"]},
    "risk_band": {"type": ["string", "null"]},
    "readiness": {"type": ["string", "null"]},
    "auto_capture": {"const": true},
    "auto_analysis": {"const": true},
    "auto_trust_assessment": {"type": "boolean"},
    "auto_packet_prepare": {"type": "boolean"},
    "human_review_recorded": {"const": false},
    "outcome_recorded": {"const": false},
    "automation_authorized": {"const": false},
    "pilot_authorized": {"const": false},
    "deterministic_replay_bound": {"type": "boolean"},
    "deterministic_result_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
