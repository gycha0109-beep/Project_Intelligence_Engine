{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/operational-policy-binding.schema.json",
  "title": "PIE Operational Review Loop v1 Operational Policy Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "project_id",
    "candidate_id",
    "repository",
    "pull_request",
    "task_id",
    "source_revision",
    "changed_files",
    "policy",
    "match_status",
    "matched_operational_classes",
    "selected_operational_class",
    "requirements",
    "facts",
    "missing_inputs",
    "trust_request",
    "status",
    "next_step",
    "human_review_recorded",
    "outcome_recorded",
    "automation_authorized",
    "pilot_authorized",
    "merge_authorized",
    "deploy_authorized",
    "production_effect_authorized",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "PIE_OPERATIONAL_POLICY_BINDING_V1"},
    "project_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "name_with_owner"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "name_with_owner": {"type": "string", "minLength": 3}
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "base_oid", "head_oid"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "task_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "available",
        "authority",
        "policy_revision",
        "policy_blob_sha",
        "policy_content_sha256",
        "policy_sha256"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "available": {"type": "boolean"},
        "authority": {"const": "PR_BASE_REVISION"},
        "policy_revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "policy_blob_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "policy_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "match_status": {
      "enum": ["NO_POLICY_MATCH", "UNIQUE_POLICY_MATCH", "AMBIGUOUS_POLICY_MATCH"]
    },
    "matched_operational_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "selected_operational_class": {"type": ["string", "null"], "minLength": 1},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_task_class", "required_scenarios", "required_evidence", "readiness_policy"],
      "properties": {
        "trust_task_class": {"type": ["string", "null"]},
        "required_scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "readiness_policy": {"type": ["object", "null"]}
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplied",
        "facts_sha256",
        "completed_scenarios",
        "verified_evidence",
        "rollback_evidence",
        "replay_evidence"
      ],
      "properties": {
        "supplied": {"type": "boolean"},
        "facts_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "completed_scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verified_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rollback_evidence": {"type": ["boolean", "null"]},
        "replay_evidence": {"type": ["boolean", "null"]}
      }
    },
    "missing_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "trust_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialized", "artifact_name", "request_sha256"],
      "properties": {
        "materialized": {"type": "boolean"},
        "artifact_name": {"type": ["string", "null"], "minLength": 1},
        "request_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {
      "enum": [
        "NO_POLICY_MATCH",
        "AMBIGUOUS_POLICY_MATCH",
        "MISSING_TRUST_FIELDS",
        "TRUST_REQUEST_MATERIALIZED"
      ]
    },
    "next_step": {
      "enum": ["PROVIDE_EXPLICIT_TRUST_INPUT", "MATERIALIZE_WITH_EXISTING_AUTO2_PATH"]
    },
    "human_review_recorded": {"const": false},
    "outcome_recorded": {"const": false},
    "automation_authorized": {"const": false},
    "pilot_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_effect_authorized": {"const": false},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
