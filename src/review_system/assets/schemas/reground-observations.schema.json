{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.local/schemas/reground-observations.schema.json","title":"PIE Reground Human Observations","type":"object","additionalProperties":false,"required":["schema_version","dataset_id","project_id","reground_report_id","observations"],"properties":{"schema_version":{"const":"1.0"},"dataset_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:-]+$"},"project_id":{"type":"string","minLength":1,"maxLength":200},"reground_report_id":{"type":"string","pattern":"^reground-[0-9a-f]{32}$"},"observations":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["observation_id","relation_id","expected_status","confirmed_by","confirmed_at"],"properties":{"observation_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:-]+$"},"relation_id":{"type":"string","pattern":"^relation-[0-9a-f]{32}$"},"expected_status":{"enum":["CURRENT","STALE"]},"confirmed_by":{"type":"string","minLength":1,"maxLength":200},"confirmed_at":{"type":"string","format":"date-time"}}}}}}
