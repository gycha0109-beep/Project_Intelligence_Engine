{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/r0-evidence-acquisition-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "project_id",
    "generated_at",
    "mode",
    "target_band",
    "automation_authorized",
    "pilot_authorized",
    "workspace_contract",
    "required_inputs",
    "source_closure",
    "workspace_complete",
    "package",
    "generated",
    "blockers",
    "status",
    "next_step",
    "evidence_snapshot_sha256",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^r0-evidence-acquisition-[0-9a-f]{32}$"},
    "project_id": {"type": ["string", "null"], "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "REPORT_ONLY"},
    "target_band": {"const": "R0"},
    "automation_authorized": {"const": false},
    "pilot_authorized": {"const": false},
    "workspace_contract": {"const": "R0_EVIDENCE_ACQUISITION_WORKSPACE_V1"},
    "required_inputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "filename", "present", "sha256"],
        "properties": {
          "key": {"enum": ["attestation", "comparison_registry", "reconciliation_sources", "observation_policy"]},
          "filename": {"type": "string", "minLength": 1},
          "present": {"type": "boolean"},
          "sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
        }
      }
    },
    "source_closure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "present", "sha256"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "present": {"type": "boolean"},
          "sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
        }
      }
    },
    "workspace_complete": {"type": "boolean"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "published", "file_count"],
      "properties": {
        "attempted": {"type": "boolean"},
        "published": {"type": "boolean"},
        "file_count": {"type": "integer", "minimum": 0}
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconciliation_report_id", "observation_report_id", "pilot_evidence_run_id", "pilot_evidence_status", "source_replay_verified"],
      "properties": {
        "reconciliation_report_id": {"type": ["string", "null"]},
        "observation_report_id": {"type": ["string", "null"]},
        "pilot_evidence_run_id": {"type": ["string", "null"]},
        "pilot_evidence_status": {"type": ["string", "null"], "enum": [null, "NOT_ELIGIBLE", "ELIGIBLE_FOR_HUMAN_PILOT_AUTHORIZATION_REVIEW"]},
        "source_replay_verified": {"type": "boolean"}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {
      "enum": [
        "BLOCKED_MISSING_INPUT",
        "BLOCKED_MISSING_SOURCE_CLOSURE",
        "READY_TO_POPULATE",
        "BLOCKED_SOURCE_REPLAY",
        "PACKAGE_POPULATED_NOT_ELIGIBLE",
        "PACKAGE_POPULATED_ELIGIBLE_FOR_HUMAN_PILOT_AUTHORIZATION_REVIEW"
      ]
    },
    "next_step": {"type": "string", "minLength": 1},
    "evidence_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
